// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Student {
  id            String   @id @default(cuid())
  nom           String
  telephone     String
  ville         String   @default("")
  niveau        String
  filiere       String
  interet       String   @default("")
  etablissement String   @default("")
  contacted     Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CtaClickEvent {
  id        String   @id @default(cuid())
  ctaId     String
  label     String
  section   String
  page      String   @default("/")
  userAgent String?
  createdAt DateTime @default(now())
}

